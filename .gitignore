# ------------------------------------------------------------------ Secrets
# API keys for editor models (Claude, OpenAI-compatible servers, Ollama, ...) belong in the environment
# or in a local .env file, never in git.
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------------------------------ Models and downloaded data
# Model weights live outside the repository. Patches and tables meant for sharing are added on purpose (git add -f).
*.safetensors
*.gguf
*.ckpt
*.bin
/models/
/hf_cache/
.cache/

# ------------------------------------------------------------------ Run output
# Surgery sessions: hash-chained logs, live status files, the progress window's pid
/sessions/
*.status.json
viewer.pid

# Local output of the bench tool, and saved fact tables
/runs/
*.graft/

# Experiment trackers
wandb/
mlruns/

